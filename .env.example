# ==========================================
# crm.taaseegun.com Environment Variables
# ==========================================

# Application Config
VITE_APP_TITLE=crm.taaseegun.com
VITE_APP_NAME="OmniSocial & Lead Hub"

# Supabase Cloud Database (PostgreSQL)
# Get these free from https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Meta Developer API (Facebook & Instagram)
# Get these from https://developers.facebook.com
VITE_META_APP_ID=
VITE_META_APP_SECRET=

# Google Cloud / YouTube Data API v3
# Get from https://console.cloud.google.com
VITE_YOUTUBE_API_KEY=
